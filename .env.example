# ==============================================================================
# SonarQube Report Tool — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ==============================================================================

# --- SonarQube Connection ---------------------------------------------------
# Base URL of your SonarQube instance (no trailing slash)
SONAR_URL=http://localhost:9000

# Authentication token (generate at: SonarQube → My Account → Security → Tokens)
SONAR_TOKEN=

# --- Project ----------------------------------------------------------------
# SonarQube project key to generate the report for
SONAR_PROJECT_KEY=

# Branch name (leave empty for the main branch)
SONAR_BRANCH=

# --- Analysis Polling -------------------------------------------------------
# Compute Engine task ID (optional — extracted from .scannerwork/report-task.txt)
SONAR_TASK_ID=

# Seconds between poll attempts when waiting for analysis completion
POLL_INTERVAL=5

# Maximum seconds to wait before timing out
POLL_TIMEOUT=300

# --- Report Output ----------------------------------------------------------
# Comma-separated list of formats: json,md,html,pdf,xlsx,ods
REPORT_FORMATS=json,md,html,pdf,xlsx,ods

# Directory where reports are saved (relative or absolute)
REPORT_OUTPUT_DIR=./reports

# --- Enrichment (rule descriptions & code snippets) -------------------------
# Opt-in to richer issue/hotspot details. Each enabled enrichment adds API
# calls per unique rule (and per unique file for code snippets), so the
# default report stays minimal and fast.

# Show "Why is this an issue?" / "What's the risk?" rule text on every issue
# and hotspot. Modes: empty (off), "short" (first paragraph only), or "full"
# (entire section). Appears in all formats. Also drives "How to fix it"
# rendering in HTML/PDF.
INCLUDE_RULE_DESCRIPTIONS=

# Include the affected code block in HTML/PDF reports. Set to "true" to enable.
INCLUDE_CODE_SNIPPETS=false

# Lines of context shown before/after the affected lines in the code snippet.
SNIPPET_CONTEXT=3

# --- PostgreSQL (used by docker-compose.yml) --------------------------------
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar_password
POSTGRES_DB=sonarqube
