# ==============================================================================
# SonarQube Report Tool — Shell-style Configuration File
# ==============================================================================
# Copy this file to sonar-report.conf and fill in the values:
#   cp sonar-report.conf.example sonar-report.conf
#
# Configuration precedence (highest to lowest):
#   1. CLI flags (--url, --token, etc.)
#   2. Environment variables (SONAR_URL, SONAR_TOKEN, etc.)
#   3. Config file values (this file)
#   4. Built-in defaults
# ==============================================================================

# --- SonarQube Connection ---------------------------------------------------
# Base URL of your SonarQube instance (no trailing slash)
SONAR_URL=http://localhost:9000

# Authentication token (generate at: SonarQube → My Account → Security → Tokens)
SONAR_TOKEN=

# --- Project ----------------------------------------------------------------
# SonarQube project key to generate the report for
SONAR_PROJECT_KEY=

# Branch name (leave empty for the main branch)
SONAR_BRANCH=

# --- SonarCloud (optional) --------------------------------------------------
# Set to "true" if using SonarCloud (auto-detected from URL)
SONAR_CLOUD=false

# SonarCloud organization key (required when using SonarCloud)
SONAR_ORGANIZATION=

# --- Analysis Polling -------------------------------------------------------
# Compute Engine task ID (optional — extracted from .scannerwork/report-task.txt)
SONAR_TASK_ID=

# Seconds between poll attempts when waiting for analysis completion
POLL_INTERVAL=5

# Maximum seconds to wait before timing out
POLL_TIMEOUT=300

# --- Report Output ----------------------------------------------------------
# Comma-separated list of formats: json,md,html,pdf,xlsx,ods,csv
REPORT_FORMATS=json,md,html,pdf,xlsx,ods

# Directory where reports are saved (relative or absolute)
REPORT_OUTPUT_DIR=./reports

# Custom HTML template file (overrides the bundled default; affects HTML + PDF).
# Leave empty to use templates/report.html.tpl.
HTML_TEMPLATE=

# --- Enrichment (rule descriptions & code snippets) -------------------------
# Opt-in to richer issue/hotspot details. Each enabled enrichment adds API
# calls per unique rule (and per unique file for code snippets), so the
# default report stays minimal and fast.

# Show "Why is this an issue?" / "What's the risk?" rule text on every issue
# and hotspot. Modes: empty (off), "short" (first paragraph only), or "full"
# (entire section). Appears in all formats. Also drives "How to fix it"
# rendering in HTML/PDF.
INCLUDE_RULE_DESCRIPTIONS=

# Include the affected code block in HTML/PDF reports. Set to "true" to enable.
INCLUDE_CODE_SNIPPETS=false

# Lines of context shown before/after the affected lines in the code snippet.
SNIPPET_CONTEXT=3

# Show the Quality Profiles (rule sets, one per language) applied during
# analysis, in all report formats. Useful for audit trails. Set "true" to enable.
INCLUDE_QUALITY_PROFILES=false

# Show the name of the Quality Gate applied during analysis, in all report
# formats. Set "true" to enable.
INCLUDE_QUALITY_GATE_NAME=false

# --- Issue Display Filters --------------------------------------------------
# Limit which issues are SHOWN in the reports without changing what is fetched.
# Summary counts always reflect the full project; only the detail lists shrink.
# Hotspots are not affected by these filters.

# Show only issues at this severity or higher: BLOCKER, CRITICAL, MAJOR, MINOR,
# INFO. Leave empty to show all severities.
SEVERITY_THRESHOLD=

# Show only these comma-separated issue types: BUG, VULNERABILITY, CODE_SMELL.
# Leave empty to show all types.
ISSUE_TYPES=

# Show at most this many issues (highest severity kept), applied after the
# severity/type filters. Leave empty for no limit.
MAX_ISSUES=

# --- Additional Options -----------------------------------------------------
# Analysis ID (optional — for reporting purposes)
ANALYSIS_ID=

# Dry-run mode: skip API calls and regenerate reports from a saved JSON file
DRY_RUN_FILE=

# Post a summary notification to a webhook URL after report generation
NOTIFY_WEBHOOK=
